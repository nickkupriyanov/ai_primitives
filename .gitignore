# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/frontend/node_modules
/backend/venv/
/backend/.venv/
/venv/
/.venv/

# testing
/coverage
.pytest_cache/
**/.pytest_cache/

# next.js
/.next/
/frontend/.next/
/out/
/frontend/out/

# python
__pycache__/
**/__pycache__/
*.py[cod]
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.pytest_cache/**
.ruff_cache/
.mypy_cache/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.commandcode
